{
  "spec_version": "1.0",
  "fmtcontrol_version": "0.1.0",
  "algorithm": {
    "digest": "SHA-256 of the UTF-8 bytes of f'{seed}:{key}'",
    "rng_seed": "big-endian integer from the first 8 bytes of that digest",
    "rng": "Mersenne Twister MT19937, as CPython random.Random",
    "shuffle": "CPython random.shuffle: Fisher-Yates descending, j = _randbelow(i + 1)",
    "displacement": "reshuffle until at least one position differs by value; max 64 attempts",
    "note": "Level 2 conformance requires bit-exact reproduction of this pipeline. See SPEC.md for why the RNG is pinned to MT19937 and why that is a known wart rather than a design choice."
  },
  "vectors": [
    {
      "id": "basic-3",
      "why": "smallest case with a meaningful permutation",
      "seed": 991,
      "key": "item-1",
      "entities": [
        "a",
        "b",
        "c"
      ],
      "values": [
        1,
        2,
        3
      ],
      "expected_permuted_values": [
        2,
        3,
        1
      ]
    },
    {
      "id": "k4-tuples",
